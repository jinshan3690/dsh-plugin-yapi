{
  "name": "dsh-plugin-yapi",
  "version": "1.6.5",
  "description": "YAPI 接口文档面板 for DeepSeek Harness：搜索、多标签、字段树、勾选复制，附带 yapi-doc skill 与零依赖 CLI。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "bin/**/*.mjs",
    "skills/**/*",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "yapi",
    "yapi-doc",
    "api-docs",
    "api-documentation",
    "skills"
  ],
  "bin": {
    "yapi-doc": "bin/yapi-doc.mjs",
    "yapi-sync": "bin/yapi-sync.mjs"
  },
  "license": "MIT",
  "author": "jinshan3690",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinshan3690/dsh-plugin-yapi.git"
  },
  "homepage": "https://github.com/jinshan3690/dsh-plugin-yapi#readme",
  "bugs": {
    "url": "https://github.com/jinshan3690/dsh-plugin-yapi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  }
}
